DATABASE_URL="postgresql://postgres:postgres@localhost:5432/designer_kicks"
# Password for /admin. LEAVE THIS BLANK HERE.
#
# This file is committed to a public repository, so anything written on
# the right-hand side is published. A default password in a public repo
# is not a default, it is a published password — and the door it opens is
# the one with every artist's phone number and street address behind it.
# Put the real value in .env (git-ignored) and in the host's own
# environment settings, never here.
ADMIN_PASSWORD=""
# Optional: get an email heads-up when applications, submissions, or sales come in
ADMIN_EMAIL=""
# Second admin lock: comma-separated member emails allowed into /admin.
# When set, admin requires being signed in as one of these accounts AND
# the password. Set it to your own login email in production.
ADMIN_EMAILS=""
# Public URL of the deployed site — used for SEO tags, sitemap, and RSS
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Auth (required). Generate your OWN and never paste it back into this file:
#
#   openssl rand -base64 32
#
# This is the key that signs every session cookie. Anyone who knows it can
# mint a valid session for any account on the site, including an admin
# one, without ever seeing a password — so a real value published here is
# a complete authentication bypass, not a config nit. It stays empty in
# the committed example on purpose.
AUTH_SECRET=""

# OAuth sign-in (optional — buttons appear when set)
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Facebook: https://developers.facebook.com/apps — add "Facebook Login"
# to your Meta app, set the OAuth redirect to
# https://theheatchart.com/api/auth/callback/facebook, then paste App ID
# and App Secret here. One login covers Facebook AND Instagram users
# (they sign in with the FB account linked to their IG).
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Official channels in the site footer (optional — unset stays hidden)
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_YOUTUBE_URL=""

# Password reset emails via https://resend.com (optional — dev mode shows link on screen)
RESEND_API_KEY=""
EMAIL_FROM="The Heat Chart <noreply@theheatchart.com>"

# Store Scout (beta, admin-only): Google Places API (New) key for
# scanning shoe stores around a zip code. Optional — the board still
# works with hand-added stores when unset.
GOOGLE_PLACES_API_KEY=""

# Broadcast cross-posting (Meta Graph API). Get these from a Meta app
# with pages_manage_posts + instagram_content_publish:
#   FB_PAGE_ID            — the Facebook Page's numeric id
#   FB_PAGE_ACCESS_TOKEN  — a long-lived PAGE access token for it
#   IG_USER_ID            — the IG Business account linked to that Page
# Unset = the Broadcast composer still posts to The Feed and hands you
# paste-ready copy for manual posting.
FB_PAGE_ID=""
FB_PAGE_ACCESS_TOKEN=""
IG_USER_ID=""

# House Threads account (graph.threads.net — separate token family from
# the Facebook Page token). THREADS_USER_ID is the numeric Threads user
# id; the token needs threads_basic + threads_content_publish.
THREADS_USER_ID=""
THREADS_ACCESS_TOKEN=""

# Editor channel connections — lets editors/artists link THEIR OWN
# accounts so approved pieces auto-post to their feeds.
#   INSTAGRAM_APP_ID/SECRET — the "Instagram App ID/Secret" from the
#     CREATORS app's Instagram-business-login setup screen (NOT the
#     top-level Meta app id; the business app holds the other IG
#     flavor and one app can't hold both).
#   THREADS_APP_ID/SECRET   — the "Threads App ID/Secret" pair from
#     the BUSINESS app's Threads use case (its own credential pair,
#     listed below the Meta app id on the same Basic settings page).
#   META_BUSINESS_APP_ID/SECRET — the BUSINESS app (Pages, Messenger,
#     Instagram, Threads, Marketing API). Separate from
#     FACEBOOK_CLIENT_* because Meta's consumer Facebook Login use case
#     (the fan sign-in button) cannot share an app with business use
#     cases. NO fallback: the login app's secret signs nothing here.
#     Borrowing it produces a valid-looking appsecret_proof that Meta
#     rejects on every Page call, which reads as an expired token and
#     retires connected artist accounts permanently.
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
THREADS_APP_ID=""
THREADS_APP_SECRET=""
META_BUSINESS_APP_ID=""
META_BUSINESS_APP_SECRET=""
# Optional: Facebook Login for Business configuration id — when Meta's
# dashboard gives the business app a login "configuration", set it and
# the editor page-connect dialog uses config_id instead of raw scopes.
META_FLB_CONFIG_ID=""

# Meta webhooks (real-time comments/DMs into the admin Engagement
# desk). Any random string — it just has to match what you type into
# the app dashboard's webhook subscription form. Callback URL:
#   https://theheatchart.com/api/meta/webhooks
META_WEBHOOK_VERIFY_TOKEN=""

# Google Analytics 4 measurement id (G-XXXXXXXXXX). OPTIONAL override —
# the live theheatchart.com property id is built in and loads on that
# domain automatically (never on localhost/e2e/previews). Set this only
# to point at a different property. Build-time var (NEXT_PUBLIC_*).
# Honors Do Not Track and the /privacy opt-out.
NEXT_PUBLIC_GA_ID=""

# Affiliate tags for the /go outbound layer (all optional — links work
# untagged until these are set). Two template styles:
#   "&param=value"  -> appended to the target URL (eBay-style)
#   "https://...{url}" -> replaces the link entirely; {url} = encoded
#                          target (Impact/Sovrn-style deep links)
AFF_EBAY_TEMPLATE=""        # e.g. "&mkcid=1&mkrid=711-53200-19255-0&campid=YOURCAMPID&toolid=10001"
AFF_STOCKX_TEMPLATE=""      # e.g. "https://stockx.pxf.io/c/YOURID/YOURPROG/9060?u={url}"
AFF_GOAT_TEMPLATE=""
AFF_KICKSCREW_TEMPLATE=""
AFF_FLIGHTCLUB_TEMPLATE=""
AFF_FOOTLOCKER_TEMPLATE=""
AFF_JDSPORTS_TEMPLATE=""
AFF_END_TEMPLATE=""
AFF_AMAZON_TEMPLATE=""      # e.g. "&tag=yourtag-20"
AFF_ANGELUS_TEMPLATE=""
AFF_RESHOEVN8R_TEMPLATE=""
AFF_CREP_TEMPLATE=""
AFF_JASONMARKK_TEMPLATE=""
AFF_LACELAB_TEMPLATE=""
AFF_UNDEFEATED_TEMPLATE=""

# Stripe for quiz credit packs (optional — dev purchase button appears when unset)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Object storage for uploads (optional — local disk used when unset)
# Works with Cloudflare R2, AWS S3, Supabase Storage, Backblaze B2
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
# Endpoint required for R2/Supabase/B2 (leave blank for AWS S3)
S3_ENDPOINT=""
S3_REGION="auto"

# Protects every /api/cron/* endpoint. REQUIRED IN PRODUCTION.
#
# Generate with: openssl rand -base64 32
#
# Behind these URLs: battle finalisation (it closes votes on schedule),
# metered third-party API spend, and the weekly recap send to every active
# member. Left blank in production they now return 401 to everyone rather
# than running for anyone — including your real scheduler. If the nightly
# job starts 401ing, this variable is empty, and that is the intended
# noise: the alternative is a stranger holding the button that mails your
# whole user list.
CRON_SECRET=""

# Optional privacy-friendly analytics — set to your domain to enable Plausible
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# Set to "true" ONLY in local/test environments: allows free credit-pack
# grants when Stripe is unconfigured. NEVER set in production — without it,
# a Stripe-less launch shows "packs coming soon" instead of free credits.
PAYMENTS_DEV_MODE=""

# Attestation that the Gemini key is on a PAID tier with Google's data
# processing terms in place. Meta's Platform Terms only let us hand
# their data to a third party that processes it solely at our direction;
# Google's unpaid tier trains on what it is sent, which breaks that.
# Until this is set, the bot will not send a commenter's photo anywhere.
# Setting it is a human attestation. Nothing here verifies it.
META_SERVICE_PROVIDER_ATTESTED=
